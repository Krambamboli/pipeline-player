# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# ── Node / Next.js ─────────────────────────────────────────────────────────
**/node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
/coverage
/.next/
/out/
/build
*.tsbuildinfo
next-env.d.ts
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ── Python ─────────────────────────────────────────────────────────────────
**/__pycache__/
*.py[cod]
*$py.class
.venv*

# ── Environment & Secrets ───────────────────────────────────────────────────
.env
.env.*
*.env

# ── Auto-generated pipeline outputs (never commit) ─────────────────────────
outputs/
chunk_runs/
qdrant_storage/

# ── Local test data (user-specific, can be large) ──────────────────────────
test_data/*
!test_data/.gitkeep
test_data.zip

# ── Config profiles — only track the default, ignore user experiments ──────
configs/*
!configs/default.yaml

# ── Auto-generated Graph RAG artefacts ────────────────────────────────────
graph_*.json

# ── Temporary / scratch files ──────────────────────────────────────────────
backend/test_gemini.py

# ── macOS ──────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store*
*DS_Store
*.pem

# ── Vercel ─────────────────────────────────────────────────────────────────
.vercel
